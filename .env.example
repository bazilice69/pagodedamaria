APP_NAME="Pagode da Dona Maria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco de dados — SQLite por padrao (zero config pra comecar rapido).
# Para producao na Hostinger, troque para mysql e preencha os dados.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pagodedamaria
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@pagodedadonamaria.org"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

# ---- Dados da Associacao (podem ser editados depois no painel) ----
ASSOCIACAO_NOME="Pagode da Dona Maria"
ASSOCIACAO_PIX="chave-pix-aqui"
ASSOCIACAO_WHATSAPP="5511999999999"
